{
  "name": "uztrade-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/test-unit.mjs",
    "data:build": "node scripts/data/build-procedures.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "node scripts/db/setup.mjs",
    "db:start": "node scripts/db/local-postgres.mjs start",
    "db:stop": "node scripts/db/local-postgres.mjs stop",
    "db:psql": "node scripts/db/local-postgres.mjs psql",
    "db:pull": "node scripts/db/pull.mjs",
    "db:sync": "tsx scripts/db/sync-master.ts",
    "db:prune-duplicates": "tsx scripts/db/prune-duplicate-cases.ts",
    "build:vercel": "next build",
    "eval": "tsx evals/run.ts",
    "eval:offline": "tsx evals/run.ts --offline",
    "eval:docai": "tsx scripts/eval/eval-docai.ts",
    "test:e2e": "node --import ./tests/e2e/register-loader.mjs --test tests/e2e/rendered-html.test.mjs tests/e2e/api-robustness.test.mjs tests/e2e/document-upload-safety.test.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "data:inputs": "node scripts/data/extract-inputs.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.10",
    "@langchain/langgraph": "^1.4.14",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "puppeteer-core": "^25.12.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
