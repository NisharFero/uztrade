# Local settings for the web app. `npm run setup` copies this to apps/.env
# (gitignored) and fills in DATABASE_URL. Never commit apps/.env.

# Database. Filled in by `npm run setup` for the local database (port 5433).
# To use a hosted database instead (e.g. Neon), put its URL here and run
# `npm run setup` again: the local database is then skipped.
DATABASE_URL=

# Optional. Without it everything still works on rules alone; with it the
# assistant understands free-text messages and uploaded documents are read by
# a vision model. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Leave empty to let the app pick the first vision model your key can use.
GROQ_VISION_MODEL=

# Entity APIs (apps/portals). `npm start` runs them on this address.
PORTALS_URL=http://127.0.0.1:8790

# Optional document AI service (apps/docai, Python) for PDFs. Not started by
# `npm start`; see apps/docai/README.md.
DOCAI_URL=http://127.0.0.1:8765

# Only needed when deployed to Vercel (stores uploaded originals).
BLOB_READ_WRITE_TOKEN=
